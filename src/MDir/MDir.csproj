<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>MDir</RootNamespace>
    <AssemblyName>M-Dir</AssemblyName>
    <Product>M-Dir</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- dotnet publish -c Release -r win-x64 : a single M-Dir.exe (see publish.ps1).
       Self-contained by default (about 49 MB, needs no installed .NET); -p:SelfContained=false gives the
       framework-dependent exe (under 1 MB, needs the .NET 10 Desktop Runtime). Trimming is not offered:
       the SDK does not support it for Windows Forms (NETSDK1175) and the COM interop here relies on reflection. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(SelfContained)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MDir.Tests" />
  </ItemGroup>

</Project>
